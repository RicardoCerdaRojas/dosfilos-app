{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ],
      "@/core/*": [
        "./src/core/*"
      ],
      "@/data/*": [
        "./src/data/*"
      ],
      "@/domain/*": [
        "./src/domain/*"
      ],
      "@/presentation/*": [
        "./src/presentation/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ]
}