---
import { createT, type Lang } from '@/lib/i18n';
import Reveal from '@/components/Reveal.astro';
import { GraduationCap, HeartHandshake, LibraryBig, Mic2 } from 'lucide-react';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = createT(lang);

const USE_CASE_ICONS = [Mic2, GraduationCap, LibraryBig, HeartHandshake];
const personas = t<Array<{ persona: string; headline: string; steps: string[]; outcome: string }>>('useCases.personas');
const useCases = personas.map((persona, idx) => ({ icon: USE_CASE_ICONS[idx], ...persona }));
---
<section id="casos-de-uso" class="bg-white py-28 md:py-36 px-6 lg:px-10 border-t border-slate-200">
    <div class="max-w-[1280px] mx-auto">
        <Reveal>
            <div class="max-w-3xl mb-16">
                <div class="text-[11px] uppercase tracking-[0.2em] text-indigo-600 font-medium mb-4">
                    {t('useCases.eyebrow')}
                </div>
                <h2 class="font-reading text-[36px] md:text-[52px] leading-[1.05] tracking-[-0.02em] text-slate-900 mb-6">
                    {t('useCases.title')}
                </h2>
                <p class="text-[16px] text-slate-600 leading-[1.65] max-w-2xl">
                    {t('useCases.intro')}
                </p>
            </div>
        </Reveal>

        <div class="grid md:grid-cols-2 gap-px bg-slate-200 border border-slate-200 rounded-xl overflow-hidden">
            {useCases.map(({ icon: Icon, persona, headline, steps, outcome }, idx) => (
                <Reveal delay={idx * 80}>
                    <div class="bg-white p-8 md:p-10 h-full flex flex-col">
                        <div class="flex items-center gap-3 mb-5">
                            <span class="inline-flex items-center justify-center h-10 w-10 rounded-md bg-indigo-50 text-indigo-600">
                                <Icon className="h-5 w-5" strokeWidth={1.5} />
                            </span>
                            <span class="text-[11px] uppercase tracking-[0.18em] text-slate-500 font-medium">
                                {persona}
                            </span>
                        </div>

                        <h3 class="font-reading text-[22px] md:text-[24px] text-slate-900 mb-5 leading-[1.25] tracking-tight">
                            {headline}
                        </h3>

                        <ol class="space-y-2.5 mb-6 flex-1">
                            {steps.map((step, stepIdx) => (
                                <li class="flex gap-3 text-[14px] text-slate-600 leading-[1.55]">
                                    <span class="font-reading text-[13px] text-indigo-600 tabular-nums shrink-0 pt-0.5">
                                        {String(stepIdx + 1).padStart(2, '0')}
                                    </span>
                                    <span>{step}</span>
                                </li>
                            ))}
                        </ol>

                        <p class="text-[13.5px] text-slate-500 italic leading-[1.6] pt-5 border-t border-slate-100">
                            {outcome}
                        </p>
                    </div>
                </Reveal>
            ))}
        </div>

        <Reveal delay={400}>
            <p class="text-[12.5px] text-slate-400 italic mt-10 text-center max-w-2xl mx-auto">
                {t('useCases.footnote')}
            </p>
        </Reveal>
    </div>
</section>
