---
import { createT, type Lang } from '@/lib/i18n';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = createT(lang);

const APP = 'https://app.preach.dosfilos.com';

// In-page anchors stay relative; app routes resolve to the app subdomain.
const PRODUCT_HREFS = ['#filosofia', '#pilar-1', '#como-funciona', `${APP}/pricing`, '#faq'];
const LEGAL_HREFS = [`${APP}/terms`, `${APP}/privacy`, `${APP}/dmca`];
const ACCOUNT_HREFS = [`${APP}/login`, `${APP}/pricing`];

function zipLinks(labels: string[], hrefs: string[]): Array<[string, string]> {
    return hrefs.map((href, i) => [labels[i] ?? '', href]);
}

const productLinks = zipLinks(t<string[]>('footer.productLinks'), PRODUCT_HREFS);
const legalLinks = zipLinks(t<string[]>('footer.legalLinks'), LEGAL_HREFS);
const accountLinks = zipLinks(t<string[]>('footer.accountLinks'), ACCOUNT_HREFS);

const columns: Array<{ title: string; links: Array<[string, string]> }> = [
    { title: t('footer.productTitle'), links: productLinks },
    { title: t('footer.legalTitle'), links: legalLinks },
    { title: t('footer.accountTitle'), links: accountLinks },
];

const year = new Date().getFullYear();
---
<footer class="bg-slate-950 text-slate-400 border-t border-white/5 py-14 px-6 lg:px-10">
    <div class="max-w-[1400px] mx-auto">
        <div class="grid md:grid-cols-12 gap-10 mb-12">
            <div class="md:col-span-5">
                <span
                    role="img"
                    aria-label="Preach DosFilos"
                    class="block h-12 w-[144px] bg-white mb-5"
                    style="-webkit-mask-image: url(/logo_dfp.png); mask-image: url(/logo_dfp.png); -webkit-mask-size: contain; mask-size: contain; -webkit-mask-position: left center; mask-position: left center; -webkit-mask-repeat: no-repeat; mask-repeat: no-repeat"
                />
                <p class="text-[13.5px] leading-relaxed max-w-sm text-slate-400">
                    {t('footer.tagline')}
                </p>
            </div>
            {columns.map(({ title, links }) => (
                <div class="md:col-span-2 md:col-start-auto">
                    <h4 class="text-white font-semibold text-[11px] uppercase tracking-[0.2em] mb-4">{title}</h4>
                    <ul class="space-y-2.5 text-[13px]">
                        {links.map(([label, href]) => (
                            <li>
                                <a href={href} class="text-slate-400 hover:text-white transition-colors">{label}</a>
                            </li>
                        ))}
                    </ul>
                </div>
            ))}
        </div>
        <div class="border-t border-white/5 pt-8 flex flex-col md:flex-row justify-between items-start md:items-center gap-4 text-[12px]">
            <div>© {year} Preach.DosFilos. {t('footer.rightsReserved')}</div>
            <div class="font-reading italic text-slate-500">
                {t('footer.scriptureTagline')}
            </div>
        </div>
        <div class="mt-4 text-[11px] text-slate-500 leading-relaxed">
            {t('footer.recaptchaPre')}{' '}
            <a
                href="https://policies.google.com/privacy"
                target="_blank"
                rel="noopener noreferrer"
                class="underline hover:text-slate-300 transition-colors"
            >
                {t('footer.recaptchaPrivacy')}
            </a>{' '}
            {t('footer.recaptchaMid')}{' '}
            <a
                href="https://policies.google.com/terms"
                target="_blank"
                rel="noopener noreferrer"
                class="underline hover:text-slate-300 transition-colors"
            >
                {t('footer.recaptchaTerms')}
            </a>{' '}
            {t('footer.recaptchaPost')}
        </div>
    </div>
</footer>
