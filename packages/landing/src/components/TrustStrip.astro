---
import { createT, type Lang } from '@/lib/i18n';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = createT(lang);

const AUTHORS = [
    'Juan Calvino',
    'Matthew Henry',
    'Charles Spurgeon',
    'Agustín de Hipona',
    'Juan Crisóstomo',
    'Gesenius',
    'Wayne Grudem',
    'Herman Bavinck',
];
---
<section class="border-y border-slate-200 bg-white py-10">
    <div class="max-w-[1400px] mx-auto px-6 lg:px-10">
        <div class="text-center text-[11px] uppercase tracking-[0.18em] text-slate-500 mb-6">
            {t('trustStrip.heading')}
        </div>
        <div class="flex flex-wrap justify-center items-center gap-x-10 gap-y-3">
            {AUTHORS.map(a => (
                <span class="font-reading text-[15px] md:text-[17px] text-slate-400 italic tracking-tight">
                    {a}
                </span>
            ))}
        </div>
    </div>
</section>
