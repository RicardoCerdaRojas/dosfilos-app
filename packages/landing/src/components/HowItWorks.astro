---
import { createT, type Lang } from '@/lib/i18n';
import Reveal from '@/components/Reveal.astro';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = createT(lang);

const steps = t<Array<{ n: string; title: string; text: string }>>('howItWorks.steps');
---
<section id="como-funciona" class="bg-white py-32 md:py-40 px-6 lg:px-10">
    <div class="max-w-[1280px] mx-auto">
        <Reveal>
            <div class="max-w-2xl mb-16">
                <div class="text-[11px] uppercase tracking-[0.2em] text-indigo-600 font-medium mb-4">
                    {t('howItWorks.eyebrow')}
                </div>
                <h2 class="font-reading text-[36px] md:text-[52px] leading-[1.05] tracking-[-0.02em] text-slate-900">
                    {t('howItWorks.title')}
                </h2>
            </div>
        </Reveal>

        <div class="grid md:grid-cols-3 gap-px bg-slate-200 border border-slate-200 rounded-xl overflow-hidden">
            {steps.map(({ n, title, text }, idx) => (
                <Reveal delay={idx * 100}>
                    <div class="bg-white p-8 md:p-10 h-full">
                        <div class="font-reading text-[52px] md:text-[64px] leading-none text-slate-300 tabular-nums font-light mb-6">
                            {n}
                        </div>
                        <h3 class="text-[18px] font-semibold text-slate-900 mb-3 tracking-tight">{title}</h3>
                        <p class="text-[14.5px] text-slate-600 leading-[1.65]">{text}</p>
                    </div>
                </Reveal>
            ))}
        </div>
    </div>
</section>
