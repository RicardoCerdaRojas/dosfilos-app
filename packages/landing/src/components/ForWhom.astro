---
import { createT, type Lang } from '@/lib/i18n';
import Reveal from '@/components/Reveal.astro';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = createT(lang);

const personas = t<Array<{ title: string; text: string }>>('forWhom.personas');
---
<section class="bg-white py-28 md:py-32 px-6 lg:px-10 border-t border-slate-200">
    <div class="max-w-[1280px] mx-auto">
        <Reveal>
            <div class="max-w-2xl mb-16">
                <div class="text-[11px] uppercase tracking-[0.2em] text-indigo-600 font-medium mb-4">
                    {t('forWhom.eyebrow')}
                </div>
                <h2 class="font-reading text-[36px] md:text-[52px] leading-[1.05] tracking-[-0.02em] text-slate-900">
                    {t('forWhom.title')}
                </h2>
            </div>
        </Reveal>

        <div class="grid md:grid-cols-2 gap-px bg-slate-200 border border-slate-200 rounded-xl overflow-hidden">
            {personas.map(({ title, text }, idx) => (
                <Reveal delay={idx * 80}>
                    <div class="bg-white p-8 h-full">
                        <h3 class="font-reading text-[22px] text-slate-900 mb-3 tracking-tight">{title}</h3>
                        <p class="text-[14.5px] text-slate-600 leading-[1.65]">{text}</p>
                    </div>
                </Reveal>
            ))}
        </div>
    </div>
</section>
