---
import { createT, type Lang } from '@/lib/i18n';
import Reveal from '@/components/Reveal.astro';
import PlanCard from '@/components/PlanCard.astro';
import { MARKETING_PLANS } from '@/config/plans';
import { ChevronRight, ArrowRight, Sparkles } from 'lucide-react';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = createT(lang);

const APP = 'https://app.preach.dosfilos.com';

const plans = [...MARKETING_PLANS]
    .filter(p => p.priceMonthly > 0)
    .sort((a, b) => a.sortOrder - b.sortOrder);

const ctaLabel = t('pricing.ctaLabel');
const freePrompt = t('pricing.freeTier.prompt');
const freeLabel = t('pricing.freeTier.label');
const freeHint = t('pricing.freeTier.hint');
---
<section id="precios" class="bg-slate-50 py-16 md:py-20 px-6 lg:px-10 border-t border-slate-200">
    <div class="max-w-[1200px] mx-auto">
        <Reveal>
            <div class="text-center max-w-2xl mx-auto mb-8">
                <div class="inline-flex flex-wrap items-center justify-center gap-x-2 gap-y-1 text-[11px] uppercase tracking-[0.2em] text-indigo-600 font-medium mb-3">
                    <span>{t('pricing.eyebrow')}</span>
                </div>
                <h2 class="font-reading text-[32px] md:text-[42px] leading-[1.05] tracking-[-0.02em] text-slate-900 mb-4">
                    {t('pricing.heading')}
                </h2>
                <p class="text-[15px] text-slate-600 leading-snug">
                    {t('pricing.subtitle')}
                </p>
            </div>
        </Reveal>

        <div class="grid md:grid-cols-3 gap-4 mt-6">
            {plans.map(plan => (
                <PlanCard plan={plan} lang={lang} ctaLabel={ctaLabel} />
            ))}
        </div>

        <p class="text-center text-[12px] text-slate-500 mt-4">
            {t('pricing.honestMicrocopy')}
        </p>

        <div class="mt-8 flex flex-wrap items-center justify-center gap-x-3 gap-y-2 text-center">
            <span class="text-[13px] text-slate-500">{freePrompt}</span>
            <a
                href={`${APP}/register?plan=free`}
                data-track="cta_pricing_free_click"
                data-track-plan-id="free"
                class="group inline-flex items-center gap-1.5 px-4 py-1.5 rounded-full border border-slate-300 bg-white hover:border-indigo-600 hover:bg-indigo-50/50 text-slate-700 hover:text-indigo-700 font-medium text-[13px] transition-all shadow-sm"
            >
                <Sparkles className="h-3.5 w-3.5 text-indigo-600" />
                {freeLabel}
                <ArrowRight className="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" />
            </a>
            <span class="text-[12px] text-slate-400">{freeHint}</span>
        </div>

        <div class="text-center mt-6">
            <a
                href={`${APP}/pricing`}
                class="inline-flex items-center gap-1 text-[12.5px] text-slate-500 hover:text-indigo-700 transition-colors"
            >
                {t('pricing.fullDetailsLink')}
                <ChevronRight className="h-3.5 w-3.5" />
            </a>
        </div>
    </div>
</section>
