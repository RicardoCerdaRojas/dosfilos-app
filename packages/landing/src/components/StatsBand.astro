---
import { createT, type Lang } from '@/lib/i18n';
import Reveal from '@/components/Reveal.astro';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = createT(lang);

const stats = t<Array<{ value: string; label: string; sub: string }>>('statsBand.stats');
---
<section class="bg-slate-950 text-white py-20 md:py-24 px-6 lg:px-10 border-y border-white/5">
    <div class="max-w-[1280px] mx-auto">
        <div class="grid md:grid-cols-4 gap-px bg-white/5">
            {stats.map(({ value, label, sub }, idx) => (
                <Reveal delay={idx * 80}>
                    <div class="bg-slate-950 p-8">
                        <div class="font-reading text-[28px] md:text-[36px] leading-none text-white mb-3 tracking-tight">
                            {value}
                        </div>
                        <div class="text-[13px] text-slate-200 mb-1 font-medium">{label}</div>
                        <div class="text-[11.5px] text-slate-500">{sub}</div>
                    </div>
                </Reveal>
            ))}
        </div>
    </div>
</section>
