---
import { createT, type Lang } from '@/lib/i18n';
import { buildMockProps } from '@/lib/mockProps';
import { ArrowRight, BookOpen, ChevronDown } from 'lucide-react';
import { HeroCarousel } from '@/components/islands/HeroCarousel';
import { TutorsMock } from '@/components/mocks/TutorsMock';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = createT(lang);
const mocks = buildMockProps(lang);

const APP = 'https://app.preach.dosfilos.com';
const leadMagnetHref = `${APP}/recursos/manual-para-predicadores?utm_source=landing&utm_medium=hero_link&utm_campaign=manual_predicacion`;

const panels = t<Array<{ label: string; sub: string }>>('heroCarousel.panels');
const panelAriaLabel = t('heroCarousel.panelAriaLabel');
---
<section class="relative bg-slate-950 text-white overflow-hidden">
    <div
        aria-hidden
        class="absolute inset-0 opacity-60 pointer-events-none"
        style="background: radial-gradient(ellipse 1200px 600px at 30% -100px, rgba(99,102,241,0.14), transparent 65%)"
    />
    <div
        aria-hidden
        class="absolute inset-0 pointer-events-none opacity-[0.05]"
        style="background-image: linear-gradient(to right, white 1px, transparent 1px), linear-gradient(to bottom, white 1px, transparent 1px); background-size: 56px 56px; -webkit-mask-image: radial-gradient(ellipse 70% 80% at 40% 40%, black 30%, transparent 85%); mask-image: radial-gradient(ellipse 70% 80% at 40% 40%, black 30%, transparent 85%)"
    />

    <div class="relative pt-32 pb-20 md:pt-40 md:pb-28 px-6 lg:px-10 max-w-[1400px] mx-auto">
        <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-center">
            <div class="lg:col-span-6">
                <div class="inline-flex items-center gap-2 text-[11px] font-medium uppercase tracking-[0.18em] text-slate-400 mb-8 animate-fade-up">
                    <span class="h-1 w-1 rounded-full bg-indigo-400" />
                    {t('hero.eyebrow')}
                </div>

                <h1
                    class="font-reading text-[44px] sm:text-[56px] md:text-[64px] lg:text-[76px] leading-[1.0] tracking-[-0.025em] text-white mb-6 animate-fade-up"
                    style="animation-delay: 100ms"
                >
                    {t('hero.title')}
                </h1>

                <p
                    class="font-reading text-[20px] md:text-[24px] leading-snug text-slate-300 mb-6 animate-fade-up max-w-xl"
                    style="animation-delay: 200ms"
                >
                    {t('hero.subtitle')}
                </p>

                <p
                    class="text-[14px] text-slate-400 italic mb-10 animate-fade-up max-w-xl"
                    style="animation-delay: 250ms"
                >
                    {t('hero.disclaimer')}
                </p>

                <div
                    class="flex flex-col sm:flex-row gap-3 items-start sm:items-center animate-fade-up"
                    style="animation-delay: 300ms"
                >
                    <a
                        href={`${APP}/register?plan=free`}
                        data-track="cta_hero_click"
                        data-track-dest="register_free"
                        class="inline-flex items-center justify-center bg-white text-slate-900 hover:bg-slate-200 h-11 px-6 rounded-md text-[14px] font-medium gap-1.5 transition-colors"
                    >
                        {t('hero.ctaPrimary')}
                        <ArrowRight className="h-3.5 w-3.5" />
                    </a>
                    <a
                        href="#como-funciona"
                        data-track="cta_secondary_click"
                        data-track-dest="como_funciona"
                        class="text-slate-400 hover:text-white text-[14px] transition-colors inline-flex items-center gap-1 px-3 py-2"
                    >
                        {t('hero.ctaSecondary')}
                        <ChevronDown className="h-3.5 w-3.5" />
                    </a>
                </div>

                <p
                    class="text-[12px] text-slate-500 mt-6 animate-fade-up"
                    style="animation-delay: 400ms"
                >
                    {t('hero.noCommitment')}
                </p>

                <a
                    href={leadMagnetHref}
                    data-track="cta_secondary_click"
                    data-track-dest="lead_magnet_manual"
                    class="inline-flex items-center gap-2 mt-8 px-4 py-2.5 rounded-md border border-indigo-400/30 bg-indigo-500/5 hover:bg-indigo-500/10 hover:border-indigo-400/50 text-[13.5px] text-indigo-200 hover:text-white transition-colors animate-fade-up group"
                    style="animation-delay: 450ms"
                >
                    <BookOpen className="h-4 w-4 text-indigo-300 group-hover:text-white transition-colors" strokeWidth={1.5} />
                    <span>
                        <span class="text-slate-400 group-hover:text-slate-300 transition-colors">{t('hero.leadMagnetPrefix')}</span>{' '}
                        {t('hero.leadMagnetText')}
                    </span>
                    <ArrowRight className="h-3.5 w-3.5" />
                </a>
            </div>

            <div
                class="lg:col-span-6 animate-fade-up"
                style="animation-delay: 500ms"
            >
                <div class="hidden lg:block">
                    <HeroCarousel
                        client:visible
                        panels={panels}
                        panelAriaLabel={panelAriaLabel}
                        hebrew={mocks.hebrew}
                        greek={mocks.greek}
                        chat={mocks.chat}
                        library={mocks.library}
                        sermon={mocks.sermon}
                    />
                </div>
                <div class="lg:hidden">
                    <TutorsMock {...mocks.tutors} />
                </div>
            </div>
        </div>

        <div
            class="mt-20 md:mt-28 pt-12 md:pt-16 border-t border-white/10 max-w-4xl animate-fade-up"
            style="animation-delay: 600ms"
        >
            <p class="text-[15px] md:text-[16px] leading-[1.7] text-slate-400">
                <span class="text-white">{t('hero.footerLead')}</span>{' '}
                {t('hero.footerBody')}
            </p>
        </div>
    </div>
</section>
