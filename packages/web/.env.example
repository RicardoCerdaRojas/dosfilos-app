# Environment Variables

# Firebase Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Gemini: el navegador ya NO lleva clave. Todas las llamadas al modelo salen por
# el servidor (callable `runLlmPrompt` / SSE `facultyChatStream`), que autentica,
# limita por usuario y mide el gasto. La clave vive solo en Secret Manager como
# `GEMINI_API_KEY`. Lo único que queda acá es el nombre del modelo, que no es
# credencial y tiene default en el código.
VITE_GEMINI_MODEL_ID=gemini-2.5-flash

# Firebase App Check (reCAPTCHA Enterprise) — bot protection on auth + checkout + leads
# Get site key from Google Cloud Console → Security → reCAPTCHA Enterprise → site key (V3, invisible).
# Register the key in Firebase Console → App Check → Apps → Web app → reCAPTCHA Enterprise.
# Skipped silently when unset (dev/CI). MUST be set in production deploys.
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_enterprise_site_key

# Optional: App Check debug token for local dev against deployed functions
# (skip when using firebase emulator — emulator auto-bypasses App Check).
# Get from Firebase Console → App Check → Apps → Web app → Manage debug tokens.
# VITE_APP_CHECK_DEBUG_TOKEN=your_debug_token_uuid
